            "pokeapi:official-artwork:155": {
              "sha256": "9532b237ef088f8032024b95459303495e261eb2f7f024b79511522e551a9bcd",
              "traits": "Match this exact Cyndaquil right-facing side pose. Preserve the long narrow pale-cream snout, one simple closed-eye arc, deep blue-teal cap and back, cream belly and short separate limbs with tiny light toe tips. The single orange-and-yellow flame is a broad jagged fan emerging from the back toward image-left, not an extra tail or limb. Keep the source's compact body, curved back-to-snout outline and quiet closed-eye expression; do not add an open eye or new markings."
            },
            "pokeapi:official-artwork:250": {
              "sha256": "2365831e6c95a5c0448e905a461530a4c18d46f8c4ca5bb57f3a0a5a05a87274",
              "traits": "Match the exact red, cream, yellow and green Ho-Oh source pose. Preserve its distinctly lobed yellow-red head crest instead of flattening it into a fan, hooked beak, layered neck feathers, individually patterned wing feathers and long separate colored tail feathers."
            },
            "pokeapi:official-artwork:255": {
              "sha256": "d234db13f46ac30452288fee011df2857d93bac22f7d038d6b472ef14a651950",
              "traits": "Match the exact orange Torchic source pose with its three-point head tuft, short beak, black eyes, cream downy neck feathers and two short legs. Preserve both feet and their actual overlap and angle as drawn in the source; do not fuse them into one invented claw."
            }
