          "source_details": {
            "pokeapi:official-artwork:152": {
              "sha256": "3ffc2eeee9139b0281ab5493b1a6d4b5c1329de5ddf5361f5ee3c93d12c05659",
              "traits": "Match this exact pale yellow-green Chikorita source pose, its rounded head and body, two separate reddish oval eyes, tiny smiling mouth, three visible short feet and a partly obscured fourth limb. Preserve the single broad green leaf arching up and toward image-right from its narrow head stem, with the leaf stem separate from the green collar buds. Keep the three round front collar buds and the small pointed buds at the side edges individually visible. Do not fuse a grass blade, collar bud or leaf stem into an extra appendage or change the source's gentle expression."
            },
            "pokeapi:official-artwork:250": {
              "sha256": "2365831e6c95a5c0448e905a461530a4c18d46f8c4ca5bb57f3a0a5a05a87274",
              "traits": "Match the exact red, cream, yellow and green Ho-Oh source pose. Preserve its distinctly lobed yellow-red head crest instead of flattening it into a fan, hooked beak, layered neck feathers, individually patterned wing feathers and long separate colored tail feathers."
            },
            "pokeapi:official-artwork:4": {
              "sha256": "a1ece1866497c8b11df3853190781c45f724a33a839cb5525597466d03deafd8",
              "traits": "Match this exact smiling Charmander source pose with both short arms extended sideways, two planted legs with white claws, tall blue eyes with dark pupils and white highlights, and an open pink mouth with the small separate white corner teeth. Preserve the broad pale cream throat and belly. The single curved tail rises to the image-right: critically, its LOWER EDGE carries a clearly visible narrow pale cream underside from behind the body along the entire upward curve to just beneath the flame. Keep that light continuous stripe distinct from the orange-brown upper tail; it must not become orange or dark brown. Copy the pointed orange-and-yellow flame, the head angle and compact source proportions. Do not add extra tails, limbs or flame ornaments."
            }
          },
