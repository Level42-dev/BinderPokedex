          "source_details": {
            "pokeapi:official-artwork:649": {
              "sha256": "0d77f632c0d27b74998040266b493c817a3643e2257e106a0feaa5fe52002b5a",
              "traits": "Match the exact purple Genesect source: angular insectlike head and paired red eyes, long separate cannon above the back, segmented torso, two distinct arms and legs, and compact clawed feet. Keep the eyes and cannon mechanically crisp, not rounded into a generic robot face."
            },
            "pokeapi:official-artwork:717": {
              "sha256": "154bd7f904c5db48ddce7cc7ff656f95cd110c7327bee28a895b11fddfcfa4a7",
              "traits": "Match the exact red-and-black Yveltal source with its narrow defined head, distinct eyes, broad Y-shaped wing-arms ending in black finger-like tips, long neck and tail, and separately visible talons. Preserve the angular silhouette and correct foot details instead of softening it into a bird."
            },
            "pokeapi:official-artwork:722": {
              "sha256": "5456dc8d55b3fd305bb7ddd4b1f94f07b51e3691414abaf4d60c7a7745f09c36",
              "traits": "Rowlet must match this exact round tan owl source pose. Preserve the two joined white facial discs, two separate dark oval eyes with white highlights, and the central white upper beak with its orange lower section. Keep the two distinct green leaves of the bow tie, the pale lower belly, both folded side wings, and the two small orange-brown feet in their original positions. Copy the source proportions, face spacing and clean rounded silhouette; do not add ears or extra limbs."
            }
          },
