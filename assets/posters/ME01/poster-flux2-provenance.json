            "pokeapi:official-artwork:1": {
              "sha256": "8e8f5588a41f5dc9006b029347e26f3eb20761160a16e2b0e4df8fb7ea9eb24a",
              "traits": "Match this exact Bulbasaur source pose and low four-legged silhouette. Keep the joined folds and pointed tips of the large green bulb, the two upright pointed ears, two separate red eyes with tall white highlights, tiny nostrils, and smiling open mouth with its pink tongue and small white corner teeth. Preserve the angular dark teal forehead, cheek, shoulder and leg markings, including the small angular spot above the near front leg. Copy the visible short legs. Each of the three fully visible feet has EXACTLY THREE separate white claw tips in IMAGE 2. In particular the large near front paw, at image-center below the small angular leg spot, must have only three white tips, not four. Match the three-tip paw outlines and keep the partly hidden farther limb hidden as in the source. Do not invent extra toes or limbs."
            },
            "pokeapi:official-artwork:152": {
              "sha256": "3ffc2eeee9139b0281ab5493b1a6d4b5c1329de5ddf5361f5ee3c93d12c05659",
              "traits": "Match this exact pale yellow-green Chikorita source pose, its rounded head and body, two separate reddish oval eyes, tiny smiling mouth, three visible short feet and a partly obscured fourth limb. Preserve the single broad green leaf arching up and toward image-right from its narrow head stem, with the leaf stem separate from the green collar buds. Keep the three round front collar buds and the small pointed buds at the side edges individually visible. Do not fuse a grass blade, collar bud or leaf stem into an extra appendage or change the source's gentle expression."
            },
            "pokeapi:official-artwork:251": {
              "sha256": "7596d91f88dfdb24bac29ad2ff37ec9652ae0aa5de9e8dab04fb0ac53ed697f1",
              "traits": "Match the exact small pale-green Celebi source, its rounded pinkish face, two fine antennae, large blue eyes, small hands and feet, thin translucent wings and tapered head crest. Keep this delicate fairy-like silhouette."
            }
          },
