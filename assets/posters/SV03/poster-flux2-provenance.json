          "source_details": {
            "pokeapi:official-artwork:4": {
              "sha256": "a1ece1866497c8b11df3853190781c45f724a33a839cb5525597466d03deafd8",
              "traits": "Match this exact smiling Charmander source pose with both short arms extended sideways, two planted legs with white claws, tall blue eyes with dark pupils and white highlights, and an open pink mouth with the small separate white corner teeth. Preserve the broad pale cream throat and belly. The single curved tail rises to the image-right: critically, its LOWER EDGE carries a clearly visible narrow pale cream underside from behind the body along the entire upward curve to just beneath the flame. Keep that light continuous stripe distinct from the orange-brown upper tail; it must not become orange or dark brown. Copy the pointed orange-and-yellow flame, the head angle and compact source proportions. Do not add extra tails, limbs or flame ornaments."
            },
            "pokeapi:official-artwork:656": {
              "sha256": "cbb47c38d234eb7dea4b1d90f8c97ec990f41b6e61f26e7efba90d80a3d1d632",
              "traits": "Match the exact blue Froakie source: large yellow eyes, pale foam scarf around the neck, rounded face, slim hind legs and individually separated fingers and toes. Keep the foam as a collar, not an extra limb."
            },
            "pokeapi:official-artwork:722": {
              "sha256": "5456dc8d55b3fd305bb7ddd4b1f94f07b51e3691414abaf4d60c7a7745f09c36",
              "traits": "Rowlet must match this exact round tan owl source pose. Preserve the two joined white facial discs, two separate dark oval eyes with white highlights, and the central white upper beak with its orange lower section. Keep the two distinct green leaves of the bow tie, the pale lower belly, both folded side wings, and the two small orange-brown feet in their original positions. Copy the source proportions, face spacing and clean rounded silhouette; do not add ears or extra limbs."
            }
          },
