  "findings": [
    {
      "subject": "Bisasam",
      "cell": "r3c1",
      "severity": "disclosed_source_detail_difference",
      "detail_de": "B zeigt drei äußere weiße Krallenformen an der bildnahen Vorderpfote. Die mittlere ist runder und trägt eine zusätzliche dunkle Innenkontur; dies kann wie eine überlagerte Spitze wirken. Der vergrößerte Vergleich ist ausdrücklich zur Nutzerentscheidung enthalten. Flecken und Knollenfalten bleiben leicht vereinfacht."
    },
    {
      "subject": "Glumanda",
      "cell": "r3c2",
      "severity": "requested_correction_present_with_minor_line_differences",
      "detail_de": "Die schmale cremefarbene Schwanzunterseite ist entlang der Kurve wieder sichtbar. Pose, beide Arme/Beine, Augen und einzelne Schwanzflamme bleiben quellnah. Zahn-/Fingerlinien sind etwas stärker vereinfacht beziehungsweise betont."
    },
    {
      "subject": "Schiggy",
      "cell": "r3c3",
      "severity": "minor_contour_differences",
      "detail_de": "Geschlossener Mund, beide Augen, segmentierter Bauchpanzer, brauner Rückenpanzer und ein eingerollter Schwanz bleiben quellnah. Finger-/Zehenlinien sind runder und kürzer; keine sicher neue fehlende Gliedmaße."
    }
  ],
  "scene_de": "Kanto-Wiese mit Flussbiegung, Waldschichten, Bergen und kleinem entferntem Gebäude. Genau drei Figuren, keine harten eingefügten Bildrechtecke. Licht und Bodenschatten nach rechts räumlich schlüssig. Vordergrundpflanzen vorhanden; ein Blatt läuft knapp an Bisasams Pfote vorbei, kein sicherer falscher Wechsel der Tiefenreihenfolge festgestellt.",
  "layout": {
    "actual_card_containment_agent_review_passed": true,
    "numeric_target_bounds_compliance_confirmed": false,
    "detail_de": "Alle sichtbaren Körperteile einschließlich Schwanzflamme, Knolle und Schwanzspirale passen mit Randabstand in die drei tatsächlichen unteren Karten. Figuren teilweise etwas höher/größer als die kleine Referenzvorgabe; keine automatisierte Silhouettenvermessung oder numerische Layoutfreigabe behauptet."
  },
